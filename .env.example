# Copy to .env and fill in. `chmod 600 .env`. Never commit .env.
# Desktop OAuth client from Google Cloud Console (see docs/SETUP.md)
PULSE_GOOGLE_CLIENT_ID=
PULSE_GOOGLE_CLIENT_SECRET=

# Where the SQLite DB, token.json and logs live (Docker overrides this to /data)
PULSE_DATA_DIR=./data
# Where `pulse probe` writes raw/ and scrubbed/ API responses
PULSE_FIXTURES_DIR=./fixtures

# Day boundaries follow this IANA zone
PULSE_TZ=America/Toronto

# Loopback port for `pulse auth` (forward it over SSH, see SETUP.md)
PULSE_OAUTH_PORT=8765

# Address the web server binds to inside docker-compose (set to your Tailscale IP to limit exposure)
PULSE_BIND=0.0.0.0

# Nightly database backup (local time). Files: data/backups/pulse-YYYY-MM-DD-HHMM.db.gz (0600),
# rotated to 7 daily, 4 weekly, 6 monthly. Point PULSE_BACKUP_DIR at another disk if you like
# (see docker-compose.yml).
# PULSE_BACKUP_ENABLED=true
# PULSE_BACKUP_TIME=03:30
# PULSE_BACKUP_DIR=
