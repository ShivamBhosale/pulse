<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed at the platform level because a Tailscale address (100.x.y.z) is
     already encrypted by WireGuard. The app itself (UrlPolicy) only accepts http:// for
     Tailscale, localhost and emulator addresses; anything else must be https://. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
