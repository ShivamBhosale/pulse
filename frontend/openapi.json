{
  "openapi": "3.1.0",
  "info": {
    "title": "Pulse",
    "description": "Self-hosted Google Health dashboard API.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Status",
        "operationId": "get_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/today": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Get Today",
        "operationId": "get_today",
        "responses": {
          "200": {
